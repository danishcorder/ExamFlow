# Copy to .env (never commit real values). On Lovable, secrets are managed in Lovable.

# --- Browser-safe (public) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Bypasses row-level security. Server code only; never prefix with VITE_, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
